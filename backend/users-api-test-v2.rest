@baseUrl = http://localhost:3001/api/v2


# MongoDB Users CRUD (/api/v2/users)

### Read all MongoDB users
GET {{baseUrl}}/users


### Read single MongoDB user
GET {{baseUrl}}/users/ใส่_MONGODB_ID_ตรงนี้


### Create a new MongoDB user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "Neeti",
  "email": "neeti@example.com",
  "password": "pass1234",
  "role": "user"
}


### Update a MongoDB user
PUT {{baseUrl}}/users/ใส่_MONGODB_ID_ตรงนี้
Content-Type: application/json

{
  "username": "Neeti Updated",
  "email": "neeti.updated@example.com",
  "role": "admin"
}


### Delete MongoDB user
DELETE {{baseUrl}}/users/ใส่_MONGODB_ID_ตรงนี้



# Supabase PostgreSQL CRUD (/api/v2/users/pg)


### Read all Supabase users
GET {{baseUrl}}/users/pg


### Read single Supabase user
GET {{baseUrl}}/users/pg/ใส่_UUID_ตรงนี้


### Create a new Supabase user
POST {{baseUrl}}/users/pg
Content-Type: application/json

{
  "username": "NeetiPG",
  "email": "neetipg@example.com",
  "password": "pass1234",
  "role": "user"
}


### Update a Supabase user
PUT {{baseUrl}}/users/pg/ใส่_UUID_ตรงนี้
Content-Type: application/json

{
  "username": "NeetiPG Updated",
  "email": "neetipg.updated@example.com",
  "role": "admin"
}


### Delete Supabase user
DELETE {{baseUrl}}/users/pg/ใส่_UUID_ตรงนี้



# ======================================================
# Auth & User Profile Specification (/auth & /users)
# ======================================================

### 1. Register a new user (POST /auth/signup)
POST http://localhost:3001/auth/signup
Content-Type: application/json

{
  "username": "alice",
  "email": "alice@example.com",
  "password": "password123",
  "role": "user"
}


### 2. Authenticate and issue JWT (POST /auth/login)
POST http://localhost:3001/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "password123"
}


### 3. Get logged-in user profile from JWT (GET /users/me)
GET {{baseUrl}}/users/me


### 4. Update logged-in user's own details (PATCH /users/me)
PATCH {{baseUrl}}/users/me
Content-Type: application/json

{
  "username": "alice_updated"
}


### 5. Admin change user role (PATCH /users/:userId/role) - Requires Admin Cookie
PATCH {{baseUrl}}/users/ใส่_USER_ID_ตรงนี้/role
Content-Type: application/json

{
  "role": "admin"
}


### 6. Admin update user details (PATCH /users/:userId) - Requires Admin Cookie
PATCH {{baseUrl}}/users/ใส่_USER_ID_ตรงนี้
Content-Type: application/json

{
  "username": "alice_admin_edit",
  "role": "admin"
}


### 7. Logout (POST /auth/logout)
POST http://localhost:3001/auth/logout